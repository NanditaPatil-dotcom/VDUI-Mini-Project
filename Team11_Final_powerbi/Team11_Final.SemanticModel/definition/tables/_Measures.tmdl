/// Home for every DAX measure in the model.
table _Measures

	column Placeholder
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Placeholder

	/// One row per passenger record.
	measure 'Total Passengers' = DISTINCTCOUNT(FactPassenger[Passenger ID])
		formatString: #,0
		displayFolder: 1 Passenger KPIs

	measure 'Satisfied Passengers' = CALCULATE([Total Passengers], FactPassenger[Satisfaction] = "Satisfied")
		formatString: #,0
		displayFolder: 1 Passenger KPIs

	measure 'Neutral or Dissatisfied Passengers' = CALCULATE([Total Passengers], FactPassenger[Satisfaction] = "Neutral or Dissatisfied")
		formatString: #,0
		displayFolder: 1 Passenger KPIs

	measure 'Satisfaction Rate' = DIVIDE([Satisfied Passengers], [Total Passengers], 0)
		formatString: 0.00%
		displayFolder: 1 Passenger KPIs

	measure 'Dissatisfaction Rate' = DIVIDE([Neutral or Dissatisfied Passengers], [Total Passengers], 0)
		formatString: 0.00%
		displayFolder: 1 Passenger KPIs

	measure 'High Tier Passengers' = CALCULATE([Total Passengers], FactPassenger[Satisfaction Tier] = "High")
		formatString: #,0
		displayFolder: 1 Passenger KPIs

	measure 'Average Tier Passengers' = CALCULATE([Total Passengers], FactPassenger[Satisfaction Tier] = "Average")
		formatString: #,0
		displayFolder: 1 Passenger KPIs

	measure 'Low Tier Passengers' = CALCULATE([Total Passengers], FactPassenger[Satisfaction Tier] = "Low")
		formatString: #,0
		displayFolder: 1 Passenger KPIs

	measure 'High Tier Rate' = DIVIDE([High Tier Passengers], [Total Passengers], 0)
		formatString: 0.0%
		displayFolder: 1 Passenger KPIs

	measure 'Low Tier Rate' = DIVIDE([Low Tier Passengers], [Total Passengers], 0)
		formatString: 0.0%
		displayFolder: 1 Passenger KPIs

	measure 'Returning Passengers' = CALCULATE([Total Passengers], DimPassengerProfile[Customer Type] = "Returning")
		formatString: #,0
		displayFolder: 1 Passenger KPIs

	measure 'First-time Passengers' = CALCULATE([Total Passengers], DimPassengerProfile[Customer Type] = "First-time")
		formatString: #,0
		displayFolder: 1 Passenger KPIs

	measure 'Returning Share' = DIVIDE([Returning Passengers], [Total Passengers], 0)
		formatString: 0.0%
		displayFolder: 1 Passenger KPIs

	measure 'Business Travel Share' = DIVIDE(CALCULATE([Total Passengers], DimTravel[Type of Travel] = "Business"), [Total Passengers], 0)
		formatString: 0.0%
		displayFolder: 1 Passenger KPIs

	/// Share of the passengers currently selected by slicers.
	measure 'Share of Passengers' = DIVIDE([Total Passengers], CALCULATE([Total Passengers], ALLSELECTED()), 0)
		formatString: 0.0%
		displayFolder: 1 Passenger KPIs

	/// Share of a category's passengers in each satisfaction bucket - bars always add to 100%.
	measure 'Satisfaction Mix %' = DIVIDE([Total Passengers], CALCULATE([Total Passengers], REMOVEFILTERS(DimSatisfaction)), 0)
		formatString: 0%
		displayFolder: 1 Passenger KPIs

	measure 'Overall Satisfaction Rate' = CALCULATE([Satisfaction Rate], REMOVEFILTERS(DimTravel), REMOVEFILTERS(DimPassengerProfile), REMOVEFILTERS(DimSatisfaction))
		formatString: 0.0%
		displayFolder: 1 Passenger KPIs

	measure 'Satisfaction Gap vs Overall (pts)' = ([Satisfaction Rate] - [Overall Satisfaction Rate]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 1 Passenger KPIs

	measure 'Avg Departure Delay' = AVERAGE(FactPassenger[Departure Delay in Minutes])
		formatString: 0.0
		displayFolder: 2 Delay & Distance

	measure 'Avg Arrival Delay' = AVERAGE(FactPassenger[Arrival Delay in Minutes])
		formatString: 0.0
		displayFolder: 2 Delay & Distance

	measure 'Avg Flight Distance' = AVERAGE(FactPassenger[Flight Distance])
		formatString: #,0
		displayFolder: 2 Delay & Distance

	measure 'Avg Passenger Age' = AVERAGE(FactPassenger[Age])
		formatString: 0.0
		displayFolder: 2 Delay & Distance

	measure 'Delayed Share' = DIVIDE(CALCULATE([Total Passengers], FactPassenger[Arrival Delay in Minutes] > 15), [Total Passengers], 0)
		formatString: 0.0%
		displayFolder: 2 Delay & Distance

	measure 'Satisfaction Rate - On Time' = CALCULATE([Satisfaction Rate], FactPassenger[Arrival Delay in Minutes] <= 15)
		formatString: 0.0%
		displayFolder: 2 Delay & Distance

	measure 'Satisfaction Rate - Delayed' = CALCULATE([Satisfaction Rate], FactPassenger[Arrival Delay in Minutes] > 15)
		formatString: 0.0%
		displayFolder: 2 Delay & Distance

	measure 'Delay Satisfaction Penalty (pts)' = ([Satisfaction Rate - Delayed] - [Satisfaction Rate - On Time]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 2 Delay & Distance

	/// Zero = not applicable, therefore excluded.
	measure 'Average Service Rating' = CALCULATE(AVERAGE(FactServiceRating[Rating]), FactServiceRating[Rating] > 0)
		formatString: 0.00
		displayFolder: 3 Service Ratings

	measure 'Rating Count' = COUNTROWS(FactServiceRating)
		formatString: #,0
		displayFolder: 3 Service Ratings

	measure 'Rated Count' = CALCULATE(COUNTROWS(FactServiceRating), FactServiceRating[Rating] > 0)
		formatString: #,0
		displayFolder: 3 Service Ratings

	measure 'Good Rating Share' = DIVIDE(CALCULATE(COUNTROWS(FactServiceRating), FactServiceRating[Rating] >= 4), [Rated Count], 0)
		formatString: 0.0%
		displayFolder: 3 Service Ratings

	measure 'Poor Rating Share' = DIVIDE(CALCULATE(COUNTROWS(FactServiceRating), FactServiceRating[Rating] >= 1, FactServiceRating[Rating] <= 2), [Rated Count], 0)
		formatString: 0.0%
		displayFolder: 3 Service Ratings

	measure 'Not Rated Share' = DIVIDE(CALCULATE(COUNTROWS(FactServiceRating), FactServiceRating[Rating] = 0), [Rating Count], 0)
		formatString: 0.0%
		displayFolder: 3 Service Ratings

	/// Share of an attribute's RATED responses (rating 1-5). Zero = not applicable, so it is excluded from numerator and denominator.
	measure 'Rating Share' =
			IF(MAX(FactServiceRating[Rating]) = 0, BLANK(),
				DIVIDE(COUNTROWS(FactServiceRating), CALCULATE(COUNTROWS(FactServiceRating), REMOVEFILTERS(FactServiceRating[Rating]), REMOVEFILTERS(FactServiceRating[Rating Category]), FactServiceRating[Rating] > 0), 0))
		formatString: 0%
		displayFolder: 3 Service Ratings

	measure 'Avg Rating - Satisfied' = CALCULATE([Average Service Rating], DimSatisfaction[Satisfaction] = "Satisfied")
		formatString: 0.00
		displayFolder: 3 Service Ratings

	measure 'Avg Rating - Neutral or Dissatisfied' = CALCULATE([Average Service Rating], DimSatisfaction[Satisfaction] = "Neutral or Dissatisfied")
		formatString: 0.00
		displayFolder: 3 Service Ratings

	measure 'Rating Gap (Satisfied - Not)' = [Avg Rating - Satisfied] - [Avg Rating - Neutral or Dissatisfied]
		formatString: +0.00;-0.00;0.00
		displayFolder: 3 Service Ratings

	measure 'Lowest Rated Attribute' = CONCATENATEX(TOPN(1, VALUES(DimServiceAttribute[Service Attribute]), [Average Service Rating], ASC), DimServiceAttribute[Service Attribute], ", ")
		displayFolder: 3 Service Ratings

	measure 'Lowest Attribute Rating' = MINX(VALUES(DimServiceAttribute[Service Attribute]), [Average Service Rating])
		formatString: 0.00
		displayFolder: 3 Service Ratings

	measure 'Highest Rated Attribute' = CONCATENATEX(TOPN(1, VALUES(DimServiceAttribute[Service Attribute]), [Average Service Rating], DESC), DimServiceAttribute[Service Attribute], ", ")
		displayFolder: 3 Service Ratings

	measure 'Highest Attribute Rating' = MAXX(VALUES(DimServiceAttribute[Service Attribute]), [Average Service Rating])
		formatString: 0.00
		displayFolder: 3 Service Ratings

	measure 'Model Accuracy' = AVERAGE(ModelComparison[Accuracy])
		formatString: 0.0%
		displayFolder: 4 Model Performance

	measure 'Model Macro Precision' = AVERAGE(ModelComparison[Macro Precision])
		formatString: 0.0%
		displayFolder: 4 Model Performance

	measure 'Model Macro Recall' = AVERAGE(ModelComparison[Macro Recall])
		formatString: 0.0%
		displayFolder: 4 Model Performance

	measure 'Model Macro F1' = AVERAGE(ModelComparison[Macro F1])
		formatString: 0.0%
		displayFolder: 4 Model Performance

	measure 'Model ROC-AUC' = AVERAGE(ModelComparison[ROC-AUC])
		formatString: 0.000
		displayFolder: 4 Model Performance

	measure 'Best Macro F1' = MAXX(ALL(ModelComparison), ModelComparison[Macro F1])
		formatString: 0.0%
		displayFolder: 4 Model Performance

	measure 'Best Model' =
			VAR b = MAXX(ALL(ModelComparison), ModelComparison[Macro F1])
			RETURN MINX(FILTER(ALL(ModelComparison), ModelComparison[Macro F1] = b), ModelComparison[Model])
		displayFolder: 4 Model Performance

	measure 'Best Accuracy' = MAXX(ALL(ModelComparison), ModelComparison[Accuracy])
		formatString: 0.0%
		displayFolder: 4 Model Performance

	measure 'Best Macro Recall' = MAXX(ALL(ModelComparison), ModelComparison[Macro Recall])
		formatString: 0.0%
		displayFolder: 4 Model Performance

	measure 'Best ROC-AUC' = MAXX(ALL(ModelComparison), ModelComparison[ROC-AUC])
		formatString: 0.000
		displayFolder: 4 Model Performance

	measure 'Fold Macro F1' = AVERAGE(CVScores[Macro F1])
		formatString: 0.0000
		displayFolder: 4 Model Performance

	measure 'CV Mean Macro F1' = AVERAGE(CVScores[Macro F1])
		formatString: 0.0000
		displayFolder: 4 Model Performance

	/// Sample std-dev (ddof=1) of the 5 fold Macro F1 scores, from Nandika's evaluation.
	measure 'CV Std Dev' = AVERAGE(ModelComparison[CV Macro F1 Std])
		formatString: 0.0000
		displayFolder: 4 Model Performance

	measure 'CV Lower Band' = [CV Mean Macro F1] - [CV Std Dev]
		formatString: 0.0000
		displayFolder: 4 Model Performance

	measure 'CV Upper Band' = [CV Mean Macro F1] + [CV Std Dev]
		formatString: 0.0000
		displayFolder: 4 Model Performance

	measure 'CV Min Macro F1' = MIN(CVScores[Macro F1])
		formatString: 0.0000
		displayFolder: 4 Model Performance

	measure 'CV Max Macro F1' = MAX(CVScores[Macro F1])
		formatString: 0.0000
		displayFolder: 4 Model Performance

	measure 'Best Model CV Std' =
			VAR bm = [Best Model]
			RETURN CALCULATE(AVERAGE(ModelComparison[CV Macro F1 Std]), ModelComparison[Model] = bm, REMOVEFILTERS(DimModel))
		formatString: 0.0000
		displayFolder: 4 Model Performance

	measure 'Best Model CV Mean' =
			VAR bm = [Best Model]
			RETURN CALCULATE(AVERAGE(ModelComparison[CV Macro F1 Mean]), ModelComparison[Model] = bm, REMOVEFILTERS(DimModel))
		formatString: 0.0000
		displayFolder: 4 Model Performance

	measure 'Subgroup Passengers' = MAX(SubgroupPerformance[Passengers])
		formatString: #,0
		displayFolder: 5 Subgroup Analysis

	/// Recall of the Satisfied class.
	measure 'Subgroup Recall' = DIVIDE(SUM(SubgroupPerformance[TP]), SUM(SubgroupPerformance[TP]) + SUM(SubgroupPerformance[FN]), 0)
		formatString: 0.0%
		displayFolder: 5 Subgroup Analysis

	measure 'Subgroup Precision' = DIVIDE(SUM(SubgroupPerformance[TP]), SUM(SubgroupPerformance[TP]) + SUM(SubgroupPerformance[FP]), 0)
		formatString: 0.0%
		displayFolder: 5 Subgroup Analysis

	measure 'Subgroup FPR' = DIVIDE(SUM(SubgroupPerformance[FP]), SUM(SubgroupPerformance[FP]) + SUM(SubgroupPerformance[TN]), 0)
		formatString: 0.0%
		displayFolder: 5 Subgroup Analysis

	measure 'Subgroup Accuracy' = DIVIDE(SUM(SubgroupPerformance[TP]) + SUM(SubgroupPerformance[TN]), SUM(SubgroupPerformance[TP]) + SUM(SubgroupPerformance[TN]) + SUM(SubgroupPerformance[FP]) + SUM(SubgroupPerformance[FN]), 0)
		formatString: 0.0%
		displayFolder: 5 Subgroup Analysis

	measure 'Subgroup Macro F1' = AVERAGE(SubgroupPerformance[Macro F1])
		formatString: 0.0%
		displayFolder: 5 Subgroup Analysis

	/// Max minus min recall across the groups in context.
	measure 'Recall Gap (pts)' = (MAXX(VALUES(SubgroupPerformance[Group Label]), [Subgroup Recall]) - MINX(VALUES(SubgroupPerformance[Group Label]), [Subgroup Recall])) * 100
		formatString: 0.0
		displayFolder: 5 Subgroup Analysis

	measure 'FPR Gap (pts)' = (MAXX(VALUES(SubgroupPerformance[Group Label]), [Subgroup FPR]) - MINX(VALUES(SubgroupPerformance[Group Label]), [Subgroup FPR])) * 100
		formatString: 0.0
		displayFolder: 5 Subgroup Analysis

	measure 'Lowest Recall Group' = CONCATENATEX(TOPN(1, VALUES(SubgroupPerformance[Group Label]), [Subgroup Recall], ASC), SubgroupPerformance[Group Label], ", ")
		displayFolder: 5 Subgroup Analysis

	measure 'Lowest Group Recall' = MINX(VALUES(SubgroupPerformance[Group Label]), [Subgroup Recall])
		formatString: 0.0%
		displayFolder: 5 Subgroup Analysis

	measure 'Disparity Flag' = IF([Recall Gap (pts)] > 10, "Material recall gap (>10 pts) - investigate", "Recall gap within 10 pts")
		displayFolder: 5 Subgroup Analysis

	/// Test-set confusion-matrix count (each passenger appears once under Gender).
	measure 'Confusion TN' = CALCULATE(SUM(SubgroupPerformance[TN]), SubgroupPerformance[Attribute] = "Gender")
		formatString: #,0
		displayFolder: 5 Subgroup Analysis

	/// Test-set confusion-matrix count (each passenger appears once under Gender).
	measure 'Confusion FP' = CALCULATE(SUM(SubgroupPerformance[FP]), SubgroupPerformance[Attribute] = "Gender")
		formatString: #,0
		displayFolder: 5 Subgroup Analysis

	/// Test-set confusion-matrix count (each passenger appears once under Gender).
	measure 'Confusion FN' = CALCULATE(SUM(SubgroupPerformance[FN]), SubgroupPerformance[Attribute] = "Gender")
		formatString: #,0
		displayFolder: 5 Subgroup Analysis

	/// Test-set confusion-matrix count (each passenger appears once under Gender).
	measure 'Confusion TP' = CALCULATE(SUM(SubgroupPerformance[TP]), SubgroupPerformance[Attribute] = "Gender")
		formatString: #,0
		displayFolder: 5 Subgroup Analysis

	measure 'Mean Abs SHAP' = SUM(ShapImportance[Mean Absolute SHAP])
		formatString: 0.000
		displayFolder: 6 SHAP & Correlation

	/// Blank for features ranked below 5 so charts show only the top five.
	measure 'Top 5 SHAP' = IF(MAX(ShapImportance[Rank]) <= 5, [Mean Abs SHAP])
		formatString: 0.000
		displayFolder: 6 SHAP & Correlation

	measure 'Top 10 SHAP' = IF(MAX(ShapImportance[Rank]) <= 10, [Mean Abs SHAP])
		formatString: 0.000
		displayFolder: 6 SHAP & Correlation

	/// Direction of influence: positive pushes toward Satisfied.
	measure 'Signed SHAP Top 10' = IF(MAX(ShapImportance[Rank]) <= 10, AVERAGE(ShapImportance[Mean SHAP]))
		formatString: +0.000;-0.000;0.000
		displayFolder: 6 SHAP & Correlation

	measure 'SHAP Share' = DIVIDE([Mean Abs SHAP], CALCULATE([Mean Abs SHAP], REMOVEFILTERS(ShapImportance)), 0)
		formatString: 0.0%
		displayFolder: 6 SHAP & Correlation

	measure 'Top Feature (SHAP)' = MINX(FILTER(ALL(ShapImportance), ShapImportance[Rank] = 1), ShapImportance[Feature])
		displayFolder: 6 SHAP & Correlation

	measure 'Top 5 Share of SHAP' = DIVIDE(CALCULATE([Mean Abs SHAP], FILTER(ALL(ShapImportance), ShapImportance[Rank] <= 5)), CALCULATE([Mean Abs SHAP], REMOVEFILTERS(ShapImportance)), 0)
		formatString: 0.0%
		displayFolder: 6 SHAP & Correlation

	measure 'Top 3 SHAP Features' = CONCATENATEX(TOPN(3, ALL(ShapImportance), ShapImportance[Rank], ASC), ShapImportance[Feature], ", ", ShapImportance[Rank], ASC)
		displayFolder: 6 SHAP & Correlation

	measure 'Effect Value' = AVERAGE(CorrelationRanking[Effect Value])
		formatString: 0.000
		displayFolder: 6 SHAP & Correlation

	measure 'Absolute Effect' = AVERAGE(CorrelationRanking[Absolute Effect])
		formatString: 0.000
		displayFolder: 6 SHAP & Correlation

	measure 'Strongest Associated Feature' = CONCATENATEX(TOPN(1, VALUES(CorrelationRanking[Feature]), [Absolute Effect], DESC), CorrelationRanking[Feature], ", ")
		displayFolder: 6 SHAP & Correlation

	measure 'Strongest Association Value' = MAXX(VALUES(CorrelationRanking[Feature]), [Absolute Effect])
		formatString: 0.000
		displayFolder: 6 SHAP & Correlation

	measure 'Significant Features' = CALCULATE(DISTINCTCOUNT(CorrelationRanking[Feature]), CorrelationRanking[Adjusted P-value] < 0.05)
		formatString: 0
		displayFolder: 6 SHAP & Correlation

	measure 'Title - Class Chart' = "Satisfaction by Travel Class  |  " & FORMAT([Total Passengers], "#,0") & " passengers in view"
		displayFolder: 8 Narrative (data-driven text)

	measure 'Title - Delay Chart' = "Satisfaction by Arrival Delay  |  on-time " & FORMAT([Satisfaction Rate - On Time], "0%") & " vs delayed " & FORMAT([Satisfaction Rate - Delayed], "0%")
		displayFolder: 8 Narrative (data-driven text)

	measure 'Title - Model Chart' = "Model comparison  |  best: " & [Best Model]
		displayFolder: 8 Narrative (data-driven text)

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table [Placeholder = text], {{""}})
				in
					Source
