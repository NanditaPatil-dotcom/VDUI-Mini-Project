          "type": "Image"
        },
        {
          "name": "model_error_bands.png",
          "path": "model_error_bands.png",
          "type": "Image"
        },
        {
          "name": "xgboost_confusion_matrix.png",
          "path": "xgboost_confusion_matrix.png",
