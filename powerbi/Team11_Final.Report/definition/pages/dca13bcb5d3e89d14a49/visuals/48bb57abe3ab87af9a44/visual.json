          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "WHAT THE DATA SAYS",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#173D75",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  43.4% of 129,487 passengers are satisfied; 33.0% reach the High tier and 34.3% the Low tier.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Business class is 69% satisfied versus 19% for Economy and 25% for Economy Plus.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Arrivals more than 15 minutes late are 36% satisfied versus 46% on time.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Lowest-rated service: In-flight Wifi Service (2.81/5); highest: In-flight Service (3.64/5).",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  XGBoost leads on held-out Macro F1 (96.4%), ROC-AUC 0.995 and accuracy 96.4%.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Five-fold CV Macro F1 for XGBoost: 0.9636 +/- 0.0014 (std-dev across folds) - stable.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  For XGBoost, recall of the Satisfied class ranges from 59.8% (Type of Travel: Personal) to 98.6% (Class: Business): a performance disparity to investigate, not proof of discrimination.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Top SHAP drivers: In-flight Wifi Service, Type of Travel, Customer Type; the top five carry 65% of total mean |SHAP|.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Computed from the project CSV outputs when the report was generated (full data set, not affected by slicers).",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#5B6B82",
                      "fontFamily": "Segoe UI",
                      "fontStyle": "italic"
                    }
                  }
