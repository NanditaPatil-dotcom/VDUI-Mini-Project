              {
                "textRuns": [
                  {
                    "value": "HOW TO READ THIS PAGE",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#173D75",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "• Correlation shows how a feature moves with satisfaction on its own.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "• SHAP shows how much the trained model relies on a feature after accounting for the others.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "• Agreement (Online Boarding, Wi-Fi, Entertainment) = a robust driver. Disagreement = overlap between features or non-linear effects.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "• Association is not causation.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI",
                      "italic": true
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
