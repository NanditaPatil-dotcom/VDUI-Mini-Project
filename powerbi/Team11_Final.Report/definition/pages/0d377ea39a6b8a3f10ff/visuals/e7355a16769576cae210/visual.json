    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "HOW TO INTERPRET",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#173D75",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "• Recall = share of truly satisfied passengers the model finds. A low value means the model under-predicts satisfaction for that group.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "• Differences may come from group size, class balance (e.g. Personal travellers are mostly dissatisfied), missing values or the decision threshold.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "• This is performance investigation - NOT proof of discrimination. Check group sample sizes before drawing conclusions.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#172334",
                      "fontFamily": "Segoe UI",
                      "fontStyle": "italic"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
