table GeminiRecommendations

	column 'Passenger Index'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Passenger Index

	column 'Evidence Feature'
		dataType: string
		summarizeBy: none
		sourceColumn: Evidence Feature

	column Recommendation
		dataType: string
		summarizeBy: none
		sourceColumn: Recommendation

	column Reason
		dataType: string
		summarizeBy: none
		sourceColumn: Reason

	partition GeminiRecommendations = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(Root & "powerbi\data\gemini_recommendations_flat.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"Passenger Index", Int64.Type}, {"Evidence Feature", type text}, {"Recommendation", type text}, {"Reason", type text}}, "en-US")
				in
					Typed
