table GeminiRecommendations

	column 'Passenger Index'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Passenger Index

	column 'Evidence Feature'
		dataType: string
		summarizeBy: none
		sourceColumn: Evidence Feature

	column Recommendation
		dataType: string
		summarizeBy: none
		sourceColumn: Recommendation

	column Reason
		dataType: string
		summarizeBy: none
		sourceColumn: Reason

	partition GeminiRecommendations = m
		mode: import
		source =
				let
					Source = #table(type table [#"Passenger Index" = Int64.Type, #"Evidence Feature" = text, #"Recommendation" = text, #"Reason" = text], {{2884, "In-flight Wifi Service", "Review in-flight connectivity, network coverage, and onboard internet reliability for passengers.", "In-flight Wifi Service contributed negatively in this prediction, driving the model output toward neutral or dissatisfied."}, {76523, "In-flight Wifi Service", "Review onboard connectivity infrastructure to see if high-speed wifi can be consistently maintained across flights.", "In-flight Wifi Service had a strong positive contribution pushing the model toward a satisfied prediction, indicating this is an important area associated with favorable ratings."}, {76523, "Online Boarding", "Examine the digital check-in and boarding pass experience to ensure it remains smooth and reliable for passengers.", "A high rating for Online Boarding contributed positively toward the predicted satisfaction outcome in the model."}})
				in
					Source
