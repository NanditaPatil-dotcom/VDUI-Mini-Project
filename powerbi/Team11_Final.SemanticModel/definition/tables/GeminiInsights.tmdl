table GeminiInsights
	description: One row per explained passenger, flattened from explainability/gemini_insights.json by build/prepare_data.py.

	column 'Passenger Index'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Passenger Index

	column 'Passenger Label'
		dataType: string
		summarizeBy: none
		sourceColumn: Passenger Label

	column 'Actual Class'
		dataType: string
		summarizeBy: none
		sourceColumn: Actual Class

	column 'Predicted Class'
		dataType: string
		summarizeBy: none
		sourceColumn: Predicted Class

	column 'Predicted Probability'
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: Predicted Probability

	column 'Probability Satisfied'
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: Probability Satisfied

	column 'Correct Prediction'
		dataType: string
		summarizeBy: none
		sourceColumn: Correct Prediction

	column Explanation
		dataType: string
		summarizeBy: none
		sourceColumn: Explanation

	column 'Evidence Features'
		dataType: string
		summarizeBy: none
		sourceColumn: Evidence Features

	column 'Uncertainty Note'
		dataType: string
		summarizeBy: none
		sourceColumn: Uncertainty Note

	column 'Gemini Model'
		dataType: string
		summarizeBy: none
		sourceColumn: Gemini Model

	column 'Generated At'
		dataType: string
		summarizeBy: none
		sourceColumn: Generated At

	partition GeminiInsights = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(RepoRoot & "powerbi\data\gemini_insights_flat.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"Passenger Index", Int64.Type}, {"Passenger Label", type text}, {"Actual Class", type text}, {"Predicted Class", type text}, {"Predicted Probability", type number}, {"Probability Satisfied", type number}, {"Correct Prediction", type text}, {"Explanation", type text}, {"Evidence Features", type text}, {"Uncertainty Note", type text}, {"Gemini Model", type text}, {"Generated At", type text}}, "en-US")
				in
					Typed
