/// One row per explained passenger, flattened from explainability/gemini_insights.json by build/prepare_data.py.
table GeminiInsights

	column 'Passenger Index'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Passenger Index

	column 'Passenger Label'
		dataType: string
		summarizeBy: none
		sourceColumn: Passenger Label

	column 'Actual Class'
		dataType: string
		summarizeBy: none
		sourceColumn: Actual Class

	column 'Predicted Class'
		dataType: string
		summarizeBy: none
		sourceColumn: Predicted Class

	column 'Predicted Probability'
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: Predicted Probability

	column 'Probability Satisfied'
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: Probability Satisfied

	column 'Correct Prediction'
		dataType: string
		summarizeBy: none
		sourceColumn: Correct Prediction

	column Explanation
		dataType: string
		summarizeBy: none
		sourceColumn: Explanation

	column 'Evidence Features'
		dataType: string
		summarizeBy: none
		sourceColumn: Evidence Features

	column 'Uncertainty Note'
		dataType: string
		summarizeBy: none
		sourceColumn: Uncertainty Note

	column 'Gemini Model'
		dataType: string
		summarizeBy: none
		sourceColumn: Gemini Model

	column 'Generated At'
		dataType: string
		summarizeBy: none
		sourceColumn: Generated At

	partition GeminiInsights = m
		mode: import
		source =
				let
					Source = #table(type table [#"Passenger Index" = Int64.Type, #"Passenger Label" = text, #"Actual Class" = text, #"Predicted Class" = text, #"Predicted Probability" = number, #"Probability Satisfied" = number, #"Correct Prediction" = text, #"Explanation" = text, #"Evidence Features" = text, #"Uncertainty Note" = text, #"Gemini Model" = text, #"Generated At" = text], {{2884, "Passenger #2884 - predicted Neutral/Dissatisfied", "Neutral or Dissatisfied", "Neutral or Dissatisfied", 0.9987551228841768, 0.0012448771158233, "Yes", "The model predicted that the passenger is neutral or dissatisfied. Features such as Type of Travel, In-flight Wifi Service, and Class lowered the estimated likelihood of satisfaction and pushed the prediction toward neutral or dissatisfied. Conversely, Check-in Service and Baggage Handling contributed positively toward satisfaction, but their influence was not strong enough to change the overall outcome.", "Type of Travel, In-flight Wifi Service, Class, Check-in Service, Baggage Handling", "SHAP values describe how the model weighted features for this specific prediction and do not establish causation or guarantee that modifying these services will change passenger satisfaction.", "gemini-3.8-flash", "2026-11-16T08:51:59.444724+00:00"}, {76523, "Passenger #76523 - predicted Satisfied", "Satisfied", "Satisfied", 0.9994921684265136, 0.9994921684265136, "Yes", "The model predicts that the passenger is satisfied with an extremely high probability. Several positive contributing factors pushed the prediction toward satisfaction, led most strongly by the passenger traveling for business rather than personal reasons, followed by high ratings for In-flight Wifi Service, Online Boarding, and Cleanliness, as well as their status as a returning customer.", "Type of Travel, In-flight Wifi Service, Customer Type, Online Boarding, Cleanliness", "SHAP describes the internal associations used by this model prediction and does not establish causation or guarantee that changing a service will change satisfaction.", "gemini-3.8-flash", "2026-11-16T08:51:59.444724+00:00"}})
				in
					Source
